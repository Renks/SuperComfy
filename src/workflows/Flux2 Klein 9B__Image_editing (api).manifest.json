{
  "manifest_version": "1.0",
  "workflow_file": "Flux2 Klein 9B__Image_editing (api).json",
  "meta": {
    "id": "flux2-klein-9b-image-edit",
    "title": "1.2 Starter - Image Editing (Flux.2 Klein 9B)",
    "short_title": "Flux.2 Klein Edit",
    "category": "Image to Image",
    "badge": "IMG2IMG • 4 STEPS",
    "description": "Instruction-based image editing, unblurring, and cinematic relighting powered by Flux.2 Klein 9B and Klein Enhancer.",
    "accent_color": "#10b981"
  },
  "ignore_nodes": ["117"],
  "extensions": {
    "image_comparer": {
      "enabled": true,
      "label": "Before / After Touch Split",
      "before_control_id": "source_image",
      "after_output_id": "main_media_output"
    }
  },
  "controls": [
    {
      "id": "source_image",
      "group": "primary",
      "component": "image_upload",
      "label": "Source Image to Edit",
      "description": "Tap to upload a photo from your device to ComfyUI /upload/image",
      "target_node": "151",
      "target_field": "inputs.image",
      "default": "20260427_165708~2.jpg"
    },
    {
      "id": "edit_prompt",
      "group": "primary",
      "component": "textarea",
      "label": "Edit Instructions & Prompt",
      "description": "Describe what to change, enhance, or preserve from the original photo",
      "target_node": "107",
      "target_field": "inputs.text",
      "rows": 5,
      "default": "unblur and upscale this image while removing the noise. Make it a film style character portrait, cinematic backdrop of natural outdoor with vegetation and sky. Shot on ARRI ALEXA 35 with Cooke S4/i. Enhance focus on the foreground subjects. Keep the people exactly the same. Preserve their facial structure, pose, clothes. Keep their skin and face exactly the same. The background is a soft creamy blur with filmic depth of field and bokeh effect. A soft sunlight acting as rimlight which seperates the subjects from the background. Field/Outdoor lighting with a Cinematic Teal & Orange color grade. High quality, 8k, masterpiece. "
    },
    {
      "id": "megapixels",
      "group": "primary",
      "component": "slider",
      "label": "Target Resolution (Megapixels)",
      "target_node": "135",
      "target_field": "inputs.value",
      "min": 0.5,
      "max": 2.5,
      "step": 0.25,
      "default": 1.0
    },
    {
      "id": "steps",
      "group": "primary",
      "component": "slider",
      "label": "Sampling Steps",
      "target_node": "133",
      "target_field": "inputs.steps",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 4
    },
    {
      "id": "seed",
      "group": "primary",
      "component": "seed",
      "label": "Generation Seed",
      "target_node": "133",
      "target_field": "inputs.seed",
      "default": 631376600223983,
      "randomize_by_default": true
    },
    {
      "id": "edit_text_weight",
      "group": "tuning",
      "component": "slider",
      "label": "Edit Text Weight",
      "target_node": "152",
      "target_field": "inputs.edit_text_weight",
      "min": 0.0,
      "max": 1.5,
      "step": 0.05,
      "default": 0.7
    },
    {
      "id": "enhancer_magnitude",
      "group": "tuning",
      "component": "slider",
      "label": "Klein Enhancer Magnitude",
      "target_node": "152",
      "target_field": "inputs.magnitude",
      "min": 0.0,
      "max": 2.0,
      "step": 0.05,
      "default": 0.85
    },
    {
      "id": "preserve_original",
      "group": "tuning",
      "component": "slider",
      "label": "Preserve Original Structure",
      "target_node": "152",
      "target_field": "inputs.preserve_original",
      "min": 0.0,
      "max": 1.0,
      "step": 0.05,
      "default": 0.0
    },
    {
      "id": "flux_guidance",
      "group": "tuning",
      "component": "slider",
      "label": "Flux Guidance",
      "target_node": "100",
      "target_field": "inputs.guidance",
      "min": 1.0,
      "max": 10.0,
      "step": 0.5,
      "default": 4.0
    },
    {
      "id": "batch_size",
      "group": "tuning",
      "component": "slider",
      "label": "Batch Count",
      "target_node": "105",
      "target_field": "inputs.batch_size",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 1
    },
    {
      "id": "unet_name",
      "group": "advanced",
      "component": "model_dropdown",
      "label": "Diffusion UNET Model",
      "target_node": "126",
      "target_field": "inputs.unet_name",
      "object_info_class": "UNETLoader",
      "object_info_param": "unet_name",
      "default": "flux-2-klein-9b.safetensors",
      "options": [
        "flux-2-klein-9b.safetensors",
        "flux1-dev-fp8.safetensors",
        "z_image_turbo_bf16.safetensors"
      ]
    },
    {
      "id": "preserve_mode",
      "group": "advanced",
      "component": "dropdown",
      "label": "Klein Preserve Mode",
      "target_node": "152",
      "target_field": "inputs.preserve_mode",
      "default": "linear",
      "options": ["linear", "cosine", "sigmoid"]
    },
    {
      "id": "low_vram",
      "group": "advanced",
      "component": "toggle",
      "label": "Low VRAM Mode (Klein Enhancer)",
      "target_node": "152",
      "target_field": "inputs.low_vram",
      "default": false
    },
    {
      "id": "sampler_name",
      "group": "advanced",
      "component": "dropdown",
      "label": "Sampler Algorithm",
      "target_node": "133",
      "target_field": "inputs.sampler_name",
      "default": "dpmpp_sde",
      "options": ["dpmpp_sde", "euler", "euler_ancestral", "dpmpp_2m", "res_multistep"]
    },
    {
      "id": "scheduler",
      "group": "advanced",
      "component": "dropdown",
      "label": "Scheduler",
      "target_node": "133",
      "target_field": "inputs.scheduler",
      "default": "beta",
      "options": ["beta", "simple", "normal", "karras", "sgm_uniform"]
    },
    {
      "id": "filename_prefix",
      "group": "advanced",
      "component": "text",
      "label": "Output Filename Prefix",
      "target_node": "9",
      "target_field": "inputs.filename_prefix",
      "default": "Flux2_dev"
    }
  ],
  "outputs": [
    {
      "id": "main_media_output",
      "target_node": "9",
      "media_type": "any_media",
      "supported_extensions": ["png", "jpg", "jpeg", "webp"],
      "label": "Edited Image Output"
    }
  ]
}